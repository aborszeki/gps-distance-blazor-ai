@inherits LocalizedComponentBase

<div class="langs" role="group" aria-label="Language">
  @foreach (var language in UiTexts.Languages)
  {
    <button type="button"
            class="flag @(language.Code == L.Language ? "active" : null)"
            title="@language.Name"
            aria-label="@language.Name"
            aria-pressed="@(language.Code == L.Language ? "true" : "false")"
            @onclick="() => L.SetLanguageAsync(language.Code)">
      @switch (language.Code)
      {
        case "hu":
          <svg viewBox="0 0 30 20"><rect width="30" height="7" fill="#ce2939" /><rect y="7" width="30" height="6" fill="#fff" /><rect y="13" width="30" height="7" fill="#477050" /></svg>
          break;
        case "en":
          <svg viewBox="0 0 60 40"><rect width="60" height="40" fill="#012169" /><path d="M0 0L60 40M60 0L0 40" stroke="#fff" stroke-width="8" /><path d="M0 0L60 40M60 0L0 40" stroke="#c8102e" stroke-width="3" /><path d="M30 0V40M0 20H60" stroke="#fff" stroke-width="13" /><path d="M30 0V40M0 20H60" stroke="#c8102e" stroke-width="8" /></svg>
          break;
        case "de":
          <svg viewBox="0 0 30 20"><rect width="30" height="7" fill="#000" /><rect y="7" width="30" height="6" fill="#dd0000" /><rect y="13" width="30" height="7" fill="#ffce00" /></svg>
          break;
      }
    </button>
  }
</div>
